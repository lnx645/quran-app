# Salin menjadi .env.local untuk pengembangan, atau pasang di Vercel
# (Settings → Environment Variables) untuk produksi. Lihat supabase/README.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Iklan halal (opsional, dorman bila kosong) — URL skrip resmi dari
# jaringan iklan halal yang dipilih. Lihat IKLAN-HALAL.md.
VITE_IKLAN_HALAL_URL_SKRIP=
